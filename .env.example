# Copy this file to .env and fill in real values. .env is gitignored.
# In production these are set as GitHub Actions repo secrets instead.

# Groq free-tier API key (LLM curation via LiteLLM) — https://console.groq.com/keys
GROQ_API_KEY=

# Gmail account used to SEND the digest
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (16 chars, spaces ok) — NOT your normal password.
# https://myaccount.google.com/apppasswords  (needs 2FA enabled)
GMAIL_APP_PASSWORD=

# Where the digest is delivered (usually the same as GMAIL_ADDRESS)
DIGEST_RECIPIENT=you@gmail.com

# --- Component 1 (collector) needs none of the above; it makes no authed calls. ---
